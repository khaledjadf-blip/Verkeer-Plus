# Copy to .env.local for local development. On Vercel: Settings → Environment Variables.

# --- E-mail (Resend, https://resend.com) -----------------------------------
# Contact form, job applications (with CV) and booking confirmations.
RESEND_API_KEY=re_xxxxxxxx
# Where requests and new bookings arrive.
CONTACT_TO_EMAIL=info@verkeersplus.nl
# Sender address. Must be on a domain verified in Resend (verkeersplus.nl).
CONTACT_FROM_EMAIL=website@verkeersplus.nl

# --- Database (Supabase) ----------------------------------------------------
# Project Settings → API. Run supabase/schema.sql once in the SQL Editor.
SUPABASE_URL=https://xxxx.supabase.co
# The SECRET service_role key (never the anon/publishable key).
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Mollie) ------------------------------------------------------
# test_xxx for testing (Preview), live_xxx for real payments (Production).
MOLLIE_API_KEY=test_xxx
# Production only: https://verkeersplus.nl (customers return here after paying).
SITE_URL=

# --- Admin (/admin) ---------------------------------------------------------
# At least 12 characters.
ADMIN_PASSWORD=
